{
  "manifest_version": 3,
  "name": "YouTube Heatmap Speed Controller",
  "version": "1.0",
  "description": "YouTubeのヒートマップ情報に基づいて再生速度を自動調整",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_idle"
    }
  ]
}

